<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_area">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ZONE HAUT : EN-TÊTE + RECHERCHE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_top_header"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="18dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mes contacts"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:letterSpacing="0.01"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Retrouvez facilement vos contacts"
                        android:textColor="#DCEBFF"
                        android:textSize="14sp"
                        android:fontFamily="sans" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnParametres"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Plus d'options"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@android:color/white" />

            </LinearLayout>

            <!-- RECHERCHE -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxStrokeColor="#FFFFFF"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="#1565C0"
                app:hintTextColor="#DCEBFF"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecherche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rechercher un contact"
                    android:textColor="#1D1B20"
                    android:textColorHint="#607D8B"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- MESSAGE VIDE -->
        <LinearLayout
            android:id="@+id/layoutVide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_contact_avatar"
                android:padding="16dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:alpha="0.85" />

            <TextView
                android:id="@+id/tvVide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aucun contact"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#45414A"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajoutez votre premier contact avec le bouton +"
                android:textSize="13sp"
                android:textColor="#85818B"
                android:gravity="center"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- LISTE -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContacts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="100dp"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- BOUTON + FLOTTANT EN BAS À DROITE -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAjouterContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:contentDescription="Ajouter un contact"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#1565C0"
        app:tint="@android:color/white"
        app:elevation="6dp" />

</FrameLayout>