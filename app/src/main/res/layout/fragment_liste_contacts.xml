<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp">

        <!-- EN-TÊTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mes contacts"
                android:textColor="#1D1B20"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:letterSpacing="0.01"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retrouvez facilement vos contacts"
                android:textColor="#77747E"
                android:textSize="14sp"
                android:fontFamily="sans"/>

        </LinearLayout>

        <!-- RECHERCHE -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxStrokeColor="#6D4C9F"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:hintTextColor="#77747E"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRecherche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rechercher un contact"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="text"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- MESSAGE VIDE -->
        <LinearLayout
            android:id="@+id/layoutVide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:alpha="0.35"/>

            <TextView
                android:id="@+id/tvVide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aucun contact"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#45414A"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajoutez votre premier contact avec le bouton +"
                android:textSize="13sp"
                android:textColor="#85818B"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- LISTE -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContacts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="100dp"
            android:scrollbars="none"/>

    </LinearLayout>

    <!-- BOUTON AJOUTER -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnAjouter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="22dp"
        android:text="Ajouter"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        android:contentDescription="Ajouter un contact"
        android:backgroundTint="#6D4C9F"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@android:color/white"
        app:cornerRadius="18dp"
        app:elevation="8dp"/>

</FrameLayout>