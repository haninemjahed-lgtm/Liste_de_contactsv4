<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Affichage">

        <ListPreference
            app:key="ordre_tri"
            app:title="Trier les contacts"
            app:entries="@array/tri_libelles"
            app:entryValues="@array/tri_valeurs"
            app:defaultValue="nom"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="taille_police"
            app:title="Taille de police"
            app:entries="@array/tailles_libelles"
            app:entryValues="@array/tailles_valeurs"
            app:defaultValue="16"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="couleur_preferee"
            app:title="Couleur du texte"
            app:entries="@array/couleurs_libelles"
            app:entryValues="@array/couleurs_valeurs"
            app:defaultValue="#000000"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="Liste des contacts">

        <androidx.preference.SwitchPreferenceCompat
            app:key="appel_depuis_liste"
            app:title="Appel depuis la liste"
            app:summary="Permettre l'appel depuis la liste"
            app:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>